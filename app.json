{
  "expo": {
    "name": "SceneGo",
    "slug": "scenego",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SceneGo 需要使用摄像头捕获异国现实场景与菜单点餐。",
        "NSMicrophoneUsageDescription": "SceneGo 需要使用麦克风进行双向语音同传与 Notes 快捷录音。",
        "NSLocationWhenInUseUsageDescription": "SceneGo 需要使用地理位置自动匹配当前所在的异国出行场景。",
        "NSSpeechRecognitionUsageDescription": "SceneGo 需要使用语音识别进行实时听写转录与语音随记。"
      },
      "bundleIdentifier": "com.ninetieth.scenego"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "scenego",
    "extra": {
      "eas": {
        "projectId": "c4128741-453b-488a-9664-dff62a07845f"
      }
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "scenego",
          "organization": "personal-4ty"
        }
      ],
      "expo-secure-store",
      "./plugins/withSentryAlwaysOutOfDate",
      "./plugins/withResetAutoSigning",
      "expo-font"
    ]
  }
}
